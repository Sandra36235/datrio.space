<script>
const T=18;let c=1;
function buildDots(){const d=document.getElementById('ndots');d.innerHTML='';for(let i=1;i<=T;i++){const b=document.createElement('div');b.className='nd'+(i===c?' on':'');b.onclick=()=>go(i);d.appendChild(b);}}
function ui(){document.querySelectorAll('.slide').forEach(s=>s.classList.remove('on'));document.getElementById('s'+c).classList.add('on');document.getElementById('ctr').textContent=c+' / '+T;document.getElementById('pb').style.width=((c/T)*100)+'%';buildDots();}
function go(n){c=Math.max(1,Math.min(T,n));ui();}
function next(){go(c+1);} function prev(){go(c-1);}
document.addEventListener('keydown',e=>{if(['ArrowRight','ArrowDown',' '].includes(e.key)){e.preventDefault();next();}if(['ArrowLeft','ArrowUp'].includes(e.key)){e.preventDefault();prev();}});
let tx=0;
document.addEventListener('touchstart',e=>{tx=e.touches[0].clientX;},{passive:true});
document.addEventListener('touchend',e=>{const dx=tx-e.changedTouches[0].clientX;if(Math.abs(dx)>45){dx>0?next():prev();}});
ui();

(function(){
  const tasks=[
    {name:"Research &amp; Discovery",  sub:"Fase 01",               cls:"b1",s:0,e:2},
    {name:"Diseño &amp; Prototipo",     sub:"Fase 02",               cls:"b2",s:2,e:4},
    {name:"Sprint 1 — Rediseño UX",   sub:"Fase 03 · Dev",         cls:"b3",s:4,e:6},
    {name:"Sprint 2 — Performance",   sub:"Fase 03 · Dev",         cls:"b3",s:6,e:8},
    {name:"Sprint 3 — Tooltips + QA", sub:"Fase 03 · Dev",         cls:"b3",s:7,e:9},
    {name:"Rollout 10%→50%→100%",     sub:"Fase 04 · Lanzamiento", cls:"b4",s:9,e:12},
    {name:"Discovery paralelo",       sub:"Voz / biometría",       cls:"bd",s:0,e:8},
  ];
  const W=12;
  const tbl=document.getElementById('gt12');

  // thead
  const th=tbl.createTHead();
  const hr=th.insertRow();
  const lh=document.createElement('th');
  lh.className='gl-col';lh.textContent='Actividad';hr.appendChild(lh);
  for(let i=1;i<=W;i++){const t=document.createElement('th');t.className='gh';t.textContent='S'+i;hr.appendChild(t);}

  // tbody
  const tb=tbl.createTBody();
  tasks.forEach((task,ti)=>{
    if(ti===tasks.length-1){
      const dr=tb.insertRow();dr.className='gdiv';
      const dtd=document.createElement('td');dtd.colSpan=W+1;
      const dl=document.createElement('div');dl.className='gdiv-line';
      dtd.appendChild(dl);dr.appendChild(dtd);
    }
    const row=tb.insertRow();row.className='gr';
    const lbl=document.createElement('td');lbl.className='gl';
    lbl.innerHTML='<div class="gn">'+task.name+'</div><div class="gs">'+task.sub+'</div>';
    row.appendChild(lbl);
    for(let w=0;w<W;w++){
      const td=document.createElement('td');td.className='gc';
      const bar=document.createElement('div');bar.className='bar';
      if(w>=task.s&&w<task.e)bar.classList.add(task.cls);
      td.appendChild(bar);row.appendChild(td);
    }
  });
